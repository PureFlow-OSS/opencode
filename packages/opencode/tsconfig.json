{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@tui/*": ["../tui/src/*"]
    }
  },
  "exclude": [
    "src/cli/cmd/tui/app.tsx",
    "src/file/ripgrep.ts",
    "src/file/watcher.ts",
    "src/provider/schema.ts",
    "src/server/routes/instance/provider.ts",
    "src/server/routes/instance/session.ts",
    "src/server/routes/instance/httpapi/provider.ts",
    "src/server/routes/instance/httpapi/session.ts",
    "src/server/routes/instance/mcp.ts",
    "test/session/prompt.test.ts",
    "test/tool/**"
  ]
}
