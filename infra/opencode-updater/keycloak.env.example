# Copy values into the deployment's private .env or secret configuration; never commit the real secret.
# Secret is required. All other values are optional overrides with the defaults shown below.
OPENCODE_ADMIN_CLIENT_SECRET=
OPENCODE_ADMIN_AUTHORITY=https://idp.rrz.co.at/realms/RSH
OPENCODE_ADMIN_CLIENT_ID=opencode-admin
OPENCODE_ADMIN_PUBLIC_ORIGIN=https://opencode-web.ai.local.programmierfabrik.at
OPENCODE_ADMIN_GROUP_CLAIM=group
OPENCODE_ADMIN_REQUIRED_GROUP=opencodeAdmin
# Alternative for an existing mapper that includes full paths in the ID token:
# OPENCODE_ADMIN_GROUP_CLAIM=groups
# OPENCODE_ADMIN_REQUIRED_GROUP=/opencodeAdmin
OPENCODE_ADMIN_SESSION_MINUTES=30
# Local Docker HTTPS only: prepare with scripts/prepare-local-keycloak-https.ps1.
# OPENCODE_ADMIN_TLS_DIR=C:/Users/your-user/.codex/secrets/opencode-updater-local-tls
